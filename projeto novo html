* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #eef4ff;
    color: #172033;
    line-height: 1.6;
    transition: background 0.3s, color 0.3s;
}

/* CABEÇALHO */

header {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    padding: 45px 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

.cabecalho {
    max-width: 1100px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

header h1 {
    font-size: 38px;
    margin-bottom: 8px;
}

header p {
    font-size: 17px;
    opacity: 0.9;
}

/* BOTÃO DO MODO ESCURO */

.botao-tema {
    border: none;
    background: white;
    color: #2563eb;
    padding: 12px 18px;
    border-radius: 25px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.botao-tema:hover {
    transform: scale(1.05);
    background: #e0e7ff;
}

/* ARTIGOS */

main {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
}

article {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(30, 64, 175, 0.12);
    transition: transform 0.3s, box-shadow 0.3s, background 0.3s;
}

article:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgba(30, 64, 175, 0.2);
}

article img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
}

.conteudo-artigo {
    padding: 24px;
}

h2 {
    color: #2563eb;
    font-size: 24px;
    margin-bottom: 8px;
}

.artigo-autor {
    color: #7c3aed;
    font-weight: bold;
    margin-bottom: 15px;
}

.artigo-fonte {
    margin-top: 15px;
    font-size: 14px;
    color: #64748b;
    font-style: italic;
}

/* BOTÕES */

.acoes {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.curtir {
    border: none;
    background: #eef2ff;
    color: #172033;
    padding: 9px 15px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 15px;
    transition: 0.2s;
}

.curtir:hover {
    background: #dbeafe;
    transform: scale(1.05);
}

.curtir:active {
    transform: scale(0.95);
}

/* RODAPÉ */

footer {
    text-align: center;
    background: #172033;
    color: white;
    padding: 25px;
    margin-top: 40px;
}

/* =========================
   MODO ESCURO
========================= */

body.modo-escuro {
    background: #0f172a;
    color: #e2e8f0;
}

body.modo-escuro header {
    background: linear-gradient(135deg, #111827, #312e81);
}

body.modo-escuro article {
    background: #1e293b;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
}

body.modo-escuro h2 {
    color: #60a5fa;
}

body.modo-escuro .artigo-autor {
    color: #a78bfa;
}

body.modo-escuro .artigo-fonte {
    color: #94a3b8;
}

body.modo-escuro .curtir {
    background: #334155;
    color: #f1f5f9;
}

body.modo-escuro .curtir:hover {
    background: #475569;
}

body.modo-escuro .botao-tema {
    background: #334155;
    color: white;
}

/* RESPONSIVIDADE */

@media (max-width: 800px) {

    .cabecalho {
        flex-direction: column;
        text-align: center;
    }

    header h1 {
        font-size: 30px;
    }

    main {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 500px) {

    header {
        padding: 30px 15px;
    }

    header h1 {
        font-size: 26px;
    }

    article img {
        height: 190px;
    }

    .conteudo-artigo {
        padding: 18px;
    }
}
